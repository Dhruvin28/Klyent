generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  password     String
  role         Role     @default(MEMBER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  clients      Client[]
  payments     Payment[]
  files        FileVersion[]
  comments     Comment[]
  activityLogs ActivityLog[]
}

enum Role {
  ADMIN
  MEMBER
}

model Client {
  id                 String        @id @default(cuid())
  name               String
  email              String?
  phone              String?
  address            String?
  projectDescription String?  @db.Text
  totalDealAmount    Decimal       @default(0) @db.Decimal(15, 2)
  status             ClientStatus  @default(ACTIVE)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  userId             String
  user               User          @relation(fields: [userId], references: [id])
  payments           Payment[]
  files              File[]
  activityLogs       ActivityLog[]

  @@index([userId])
  @@index([name])
  @@index([status])
}

enum ClientStatus {
  ACTIVE
  COMPLETED
  ON_HOLD
}

model Payment {
  id        String        @id @default(cuid())
  amount    Decimal  @db.Decimal(15, 2)
  method    PaymentMethod
  date      DateTime
  notes     String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  clientId  String
  client    Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  userId    String
  user      User          @relation(fields: [userId], references: [id])

  @@index([clientId])
  @@index([date])
}

enum PaymentMethod {
  CASH
  ONLINE
  CHEQUE
}

model File {
  id          String        @id @default(cuid())
  name        String
  description String?  @db.Text
  mimeType    String
  clientId    String
  client      Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  versions    FileVersion[]
  comments    Comment[]
  shareToken  String?       @unique @default(cuid())
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([clientId])
}

model FileVersion {
  id            String   @id @default(cuid())
  versionNumber Int
  s3Key         String   @db.VarChar(768)
  s3Bucket      String
  size          Int
  isActive      Boolean  @default(true)
  uploadedById  String
  uploadedBy    User     @relation(fields: [uploadedById], references: [id])
  fileId        String
  file          File     @relation(fields: [fileId], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now())

  @@index([fileId])
  @@index([isActive])
}

model Comment {
  id        String   @id @default(cuid())
  content   String   @db.Text
  fileId    String
  file      File     @relation(fields: [fileId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([fileId])
}

model ActivityLog {
  id        String       @id @default(cuid())
  type      ActivityType
  metadata  Json?
  clientId  String
  client    Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  userId    String
  user      User         @relation(fields: [userId], references: [id])
  createdAt DateTime     @default(now())

  @@index([clientId])
  @@index([createdAt])
}

enum ActivityType {
  PAYMENT_ADDED
  PAYMENT_UPDATED
  PAYMENT_DELETED
  FILE_UPLOADED
  FILE_VERSION_ADDED
  STATUS_CHANGED
  CLIENT_CREATED
  CLIENT_UPDATED
  COMMENT_ADDED
}
