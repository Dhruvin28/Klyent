DATABASE_URL="mysql://klyent:password@localhost:3306/klyent"
JWT_SECRET="change-this-to-a-secure-random-string"
JWT_EXPIRY="7d"
PORT=3001
HOST="0.0.0.0"
CORS_ORIGIN="http://localhost:5173"

# Cloudflare R2
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""
R2_PUBLIC_URL=""

# Gmail SMTP (used to send password-reset OTP emails)
SMTP_USER=""
SMTP_PASS=""

# Studio AI — WhatsApp project knowledge engine
# Required for AI answers/extraction/embeddings. Without it, Studio AI still
# ingests and searches (keyword-only), but /api/studio/ask returns raw
# matches instead of a synthesized answer.
OPENAI_API_KEY=""
OPENAI_CHAT_MODEL="gpt-4.1-mini"
OPENAI_EMBEDDING_MODEL="text-embedding-3-small"

# Studio AI — Option A (official WhatsApp Cloud API webhook), optional/future.
# Leave blank until you've validated Option A actually covers your use case
# (see the Studio AI README section on WhatsApp capture options).
STUDIO_WHATSAPP_VERIFY_TOKEN=""
STUDIO_WHATSAPP_ACCESS_TOKEN=""
STUDIO_WHATSAPP_PHONE_NUMBER_ID=""
STUDIO_WHATSAPP_APP_SECRET=""
